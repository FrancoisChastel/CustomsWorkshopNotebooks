{
  "1b-1": {
    "title": "Audit the rule book",
    "says": "What the data says: the four rows of R1 to R4 on months 19–36 (share of traffic, hit rate on the random draw, lift, duty per inspection, new to the book)",
    "decide": [
      {
        "key": "rules",
        "label": "Keep, revise or retire each rule, with the number that decided",
        "kind": "table",
        "required": true,
        "rows": [
          "R1",
          "R2",
          "R3",
          "R4"
        ],
        "columns": [
          {
            "key": "decision",
            "label": "Decision",
            "kind": "choice",
            "options": [
              "keep",
              "revise",
              "retire"
            ],
            "required": true
          },
          {
            "key": "number",
            "label": "The number that decided",
            "kind": "choice",
            "options": [
              "share of traffic",
              "hit rate",
              "lift",
              "lift range",
              "duty per inspection",
              "new to the book",
              "queue beyond budget"
            ],
            "required": true
          },
          {
            "key": "note",
            "label": "Note (at most 80 characters)",
            "kind": "text",
            "max": 80,
            "required": false
          }
        ]
      }
    ],
    "signs": [
      {
        "key": "owner",
        "label": "Who owns the rule book review",
        "required": true
      },
      {
        "key": "control",
        "label": "The control type of each rule you keep",
        "required": false
      },
      {
        "key": "cost",
        "label": "What retiring a rule would cost (for example a control the law makes mandatory)",
        "required": true
      }
    ]
  },
  "1b-2": {
